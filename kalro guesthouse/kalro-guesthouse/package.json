{
  "name": "kalro-guesthouse",
  "version": "1.1.0",
  "description": "KALRO Guesthouse management system: rooms, bookings, events, billing and reports",
  "main": "src/server.js",
  "scripts": {
    "start": "node --no-warnings src/server.js",
    "clean": "node -e \"for(const f of ['kalro.db','kalro.db-wal','kalro.db-shm'])require('fs').rmSync('data/'+f,{force:true})\" && node --no-warnings src/server.js",
    "demo": "node -e \"for(const f of ['kalro.db','kalro.db-wal','kalro.db-shm'])require('fs').rmSync('data/'+f,{force:true})\" && node --no-warnings src/server.js --demo",
    "reset-demo": "node -e \"for(const f of ['kalro.db','kalro.db-wal','kalro.db-shm'])require('fs').rmSync('data/'+f,{force:true})\" && node --no-warnings src/server.js --demo",
    "empty": "node -e \"for(const f of ['kalro.db','kalro.db-wal','kalro.db-shm'])require('fs').rmSync('data/'+f,{force:true})\" && node --no-warnings src/server.js --empty"
  },
  "engines": {
    "node": ">=22.13"
  },
  "license": "UNLICENSED",
  "private": true
}
